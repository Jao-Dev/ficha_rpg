= card 'Mudar sua senha' do
  .card-body
    = form_with model: resource, as: resource_name, url: password_path(resource_name), html: { method: :put } do |f|
      = f.hidden_field :reset_password_token

      - if resource.errors.any?
        = alert('danger') do
          %ul.mb-0
            - resource.errors.full_messages.each do |message|
              %li= message

      .mb-3
        = f.label :password, 'Nova senha'
        - if @minimum_password_length
          .form-hint
            = @minimum_password_length
            caracteres no mínimo
        = f.password_field :password, autofocus: true, autocomplete: 'new-password'
      .mb-3
        = f.label :password_confirmation, 'Confirmar nova senha'
        = f.password_field :password_confirmation, autocomplete: 'new-password'
      = f.submit 'Mudar minha senha'

.text-center
  = render 'devise/shared/links'
