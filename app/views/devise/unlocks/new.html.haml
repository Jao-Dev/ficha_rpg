= card 'Reenviar instruções de desbloqueio' do
  .card-body
    = form_with model: resource, as: resource_name, url: unlock_path(resource_name) do |f|
      - if resource.errors.any?
        = alert('danger') do
          %ul.mb-0
            - resource.errors.full_messages.each do |message|
              %li= message

      .mb-3
        = f.label :email
        = f.email_field :email, autofocus: true, autocomplete: 'email'
      = f.submit 'Reenviar instruções de desbloqueio'

.text-center
  = render 'devise/shared/links'
