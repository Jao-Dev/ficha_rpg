= card 'Reenviar instruções de confirmação' do
  .card-body
    = form_with model: resource, as: resource_name, url: confirmation_path(resource_name) do |f|
      - if resource.errors.any?
        = alert('danger') do
          %ul.mb-0
            - resource.errors.full_messages.each do |message|
              %li= message

      .mb-3
        = f.label :email
        = f.email_field :email, autofocus: true, autocomplete: 'email',
          value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email)
      = f.submit 'Reenviar instruções de confirmação'

.text-center
  = render 'devise/shared/links'
