= card 'Avisos' do
  - if @avisos.any?
    %ul
      - @avisos.each do |aviso|
        %li.d-flex.align-items-center
          = link_to aviso_path(aviso) do
            %strong.me-2= t("avisos.tipos.#{aviso.tipo}")
            = truncate(aviso.content, length: 80)
          .ms-auto
            = badge(aviso.read_at ? 'Lido' : 'Não lido', style: aviso.read_at ? :secondary : :primary)
  - else
    .card-body
      = empty 'Nenhum aviso ainda.'
