= form_with model: [character.user, character] do |f|
  - if character.errors.any?
    .alert.alert-danger
      %ul.mb-0
        - character.errors.full_messages.each do |message|
          %li= message
  .mb-3
    = f.label :name, class: 'form-label'
    = f.text_field :name, class: 'form-control'
  .mb-3
    = f.label :race, class: 'form-label'
    = f.text_field :race, class: 'form-control'
  .mb-3
    = f.label :campaign_id, class: 'form-label'
    = f.collection_select :campaign_id, Campaign.all, :id, :master, { prompt: 'Selecione a campanha' }, class: 'form-select'
  .mb-3
    = f.label :avatar, class: 'form-label'
    = f.file_field :avatar, class: 'form-control'
  .d-flex
    .ms-auto= f.submit character.new_record? ? 'Criar personagem' : 'Atualizar personagem', class: 'btn btn-primary'
