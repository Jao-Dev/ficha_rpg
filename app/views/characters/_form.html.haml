= form_with model: [ character.user, character ] do |f|
  - if character.errors.any?
    = alert('danger') do
      %ul.mb-0
        - character.errors.full_messages.each do |message|
          %li= message

  .mb-3
    = f.label :name
    = f.text_field :name
  .mb-3
    = f.label :race
    = f.text_field :race
  .mb-3
    = f.label :campaign_id
    = f.collection_select :campaign_id, Campaign.all, :id, :master, { prompt: 'Selecione a campanha' }
  .mb-3
    = f.label :avatar
    = f.file_field :avatar

  .d-flex
    .ms-auto
      = f.submit character.new_record? ? 'Criar personagem' : 'Atualizar personagem'
