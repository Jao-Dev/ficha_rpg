= card @character.name,
  actions: [ btn('Editar', edit_user_character_path(@character.user, @character), style: 'outline-primary'),
             btn('Excluir', user_character_path(@character.user, @character),
               style: 'outline-danger', method: :delete, confirm: 'Deseja excluir o personagem?') ] do
  .card-body
    - if @character.avatar.attached?
      = image_tag @character.avatar, class: 'rounded'
    %p= @character.race
    - if @character.campaign
      %p= @character.campaign.master

- if @character.historia.present?
  = card 'História' do
    .card-body
      = simple_format @character.historia

- if policy(@character).update? && @character.anotacoes.present?
  = card 'Anotações' do
    .card-body
      = simple_format @character.anotacoes

= render 'mochila', character: @character
= render 'armas', character: @character
= render 'efeitos', character: @character
