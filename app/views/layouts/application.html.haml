!!!
%html
  %head
    %title= content_for(:title) || 'Ficha Rpg'
    %meta{ name: 'viewport', content: 'width=device-width,initial-scale=1' }
    %meta{ name: 'apple-mobile-web-app-capable', content: 'yes' }
    %meta{ name: 'application-name', content: 'Ficha Rpg' }
    %meta{ name: 'mobile-web-app-capable', content: 'yes' }
    = csrf_meta_tags
    = csp_meta_tag

    = yield :head

    %link{ rel: 'icon', href: '/icon.png', type: 'image/png' }
    %link{ rel: 'icon', href: '/icon.svg', type: 'image/svg+xml' }
    %link{ rel: 'apple-touch-icon', href: '/icon.png' }

    = stylesheet_link_tag :app, 'data-turbo-track': 'reload'
    = javascript_importmap_tags
  %body
    .page
      %header.navbar.navbar-expand-md.d-print-none
        .container-xl
          %h1.navbar-brand.mb-0.h-auto Ficha RPG
          - if user_signed_in?
            .ms-auto.d-flex.align-items-center
              = btn 'Campanhas', campaigns_path, style: 'outline-primary'
              = btn rotulo_avisos, avisos_path, style: 'outline-primary'
              = btn 'Nova campanha', campaigns_path, style: 'outline-primary', method: :post
              %details.nav-item.dropdown.ms-2
                %summary.nav-link.d-flex.flex-column
                  %span= current_user.name
                  - if (personagem = personagem_em_uso)
                    %span
                      (#{personagem.name})
                .dropdown-menu.dropdown-menu-end
                  - current_user.characters.order(:name).each do |character|
                    = button_to character.name, alternar_user_character_path(character.user, character),
                      method: :post, class: 'dropdown-item', form: { class: 'd-inline' }
              = btn 'Log out', destroy_user_session_path, style: 'outline-secondary', method: :delete
      .page-wrapper
        .page-body
          .container-xl
            - flash.each do |type, message|
              = alert(type == 'notice' ? 'success' : 'danger', message)
            = yield
