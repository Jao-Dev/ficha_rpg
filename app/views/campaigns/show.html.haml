= card @campaign.master,
  actions: [ btn('Editar', edit_campaign_path(@campaign), style: 'outline-primary'),
             btn('Excluir', campaign_path(@campaign), style: 'outline-danger', method: :delete, confirm: 'Deseja excluir a campanha?') ] do
  .card-body
    %p= @campaign.ativo ? 'Ativa' : 'Inativa'
    %p= @campaign.created_at.strftime('%d/%m/%Y')
    - if @campaign.characters.any?
      %ul
        - @campaign.characters.each do |character|
          %li= character.name
    - else
      %p.text-secondary Nenhum personagem nesta campanha.
