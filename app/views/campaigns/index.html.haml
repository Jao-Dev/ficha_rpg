- if @pendentes.any?
  = card 'Personagens aguardando confirmação' do
    %ul
      - @pendentes.each do |vinculo|
        %li.d-flex.align-items-center
          = vinculo.character.name
          %span.ms-2
            = badge 'Pendente'
          .ms-auto.d-flex.align-items-center
            = btn 'Confirmar', campaign_campaign_character_path(vinculo.campaign, vinculo), style: 'outline-primary',
              method: :patch
            = btn 'Recusar', campaign_campaign_character_path(vinculo.campaign, vinculo), style: 'outline-danger',
              method: :delete

= card 'Busca' do
  .card-body
    = form_with url: campaigns_path, method: :get do |f|
      .d-flex
        .me-3
          = f.label :q, 'Campanha ou mestre'
          = f.text_field :q
        .me-3
          = f.label :status, 'Status'
          = f.select :status, [ [ 'Todas', '' ], [ 'Ativa', 'ativa' ], [ 'Inativa', 'inativa' ] ]
        .d-flex.align-items-end
          = f.submit 'Buscar'

= card 'Campanhas do usuário', actions: [ btn('Nova campanha', new_campaign_path, style: 'outline-primary') ] do
  - if @campanhas.any?
    %ul
      - @campanhas.each do |campaign|
        %li.d-flex.align-items-center
          = link_to campaign.nome, campaign_path(campaign)
          %span.ms-2= campaign.master.name
          .ms-auto
            = badge(campaign.ativo ? 'Ativa' : 'Inativa', style: campaign.ativo ? :success : :secondary)
  - else
    .card-body
      = empty 'Você não participa de nenhuma campanha ainda.'

= card 'Outras campanhas' do
  - if @outras.any?
    %ul
      - @outras.each do |campaign|
        %li.d-flex.align-items-center
          = link_to campaign.nome, campaign_path(campaign)
          %span.ms-2= campaign.master.name
          .ms-auto
            = badge(campaign.ativo ? 'Ativa' : 'Inativa', style: campaign.ativo ? :success : :secondary)
  - else
    .card-body
      = empty 'Nenhuma outra campanha no sistema.'
