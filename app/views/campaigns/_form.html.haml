= form_with model: campaign do |f|
  .mb-3
    = f.label :nome
    = f.text_field :nome
  .mb-3
    = f.label :resumo, 'Resumo'
    = f.text_area :resumo
  .mb-3.form-check.form-switch
    = f.check_box :ativo, class: 'form-check-input'
    = f.label :ativo, 'Ativa', class: 'form-check-label'

  .d-flex
    .ms-auto
      = f.submit campaign.new_record? ? 'Criar campanha' : 'Atualizar campanha'
