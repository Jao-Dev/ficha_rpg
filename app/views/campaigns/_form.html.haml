= form_with model: campaign do |f|
  - if campaign.errors.any?
    .alert.alert-danger
      %ul.mb-0
        - campaign.errors.full_messages.each do |message|
          %li= message
  .mb-3
    = f.label :master, class: 'form-label'
    = f.text_field :master, class: 'form-control'
  .d-flex
    .ms-auto= f.submit 'Criar campanha', class: 'btn btn-primary'
