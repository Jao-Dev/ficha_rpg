.card
  .card-header.d-flex.align-items-center
    %h1.card-title Seus personagens
    .ms-auto= link_to 'Novo personagem', new_user_character_path(current_user), class: 'btn btn-primary btn-sm'
  - if @characters.any?
    .table-responsive
      %table.table.card-table.table-vcenter
        %tbody
          - @characters.each do |character|
            %tr
              %td= link_to character.name, user_character_path(character.user, character)
  - else
    .card-body.text-secondary
      Nenhum personagem ainda.
